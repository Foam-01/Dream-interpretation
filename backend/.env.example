# Copy to .env and fill in values. Never commit .env.
NODE_ENV=development
PORT=3000
# Local development database (see README "Local PostgreSQL"). Use placeholders only here.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/dreamapp_dev?schema=public
# Optional, Prisma CLI only: direct (non-pooled) connection for migrations. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=
# Comma-separated browser origins, e.g. https://app.example.com. No "*" and no paths.
# Empty = CORS disabled (native mobile apps do not need CORS).
CORS_ORIGINS=
